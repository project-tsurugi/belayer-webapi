TZ=Asia/Tokyo

# No SPRING_PROFILES_ACTIVE here: choose the profile when starting the WebAPI
# (authmock for mock authentication; see README.md).

BELAYER_HOME=/opt/belayer
BELAYER_STORAGE_ROOT=/opt/belayer/storage
BELAYER_LOG_LEVEL=INFO
BELAYER_SERVER_PORT=8000

# Development only: serve everything on the management port (actuator, OpenAPI,
# Swagger UI; no authentication). The default is health,prometheus.
BELAYER_MANAGEMENT_EXPOSURE=health,prometheus,info,env,beans,openapi,swagger-ui
BELAYER_MANAGEMENT_PORT=18000

TSURUGI_HOME=/usr/lib/tsurugi
TSURUGI_URL=ipc:tsurugi
