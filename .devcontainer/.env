TZ=Asia/Tokyo

# Run the WebAPI with mock authentication (users: webapi/src/main/resources/application-authmock.properties).
# The official TsurugiDB image starts without the authentication server (harinoki).
SPRING_PROFILES_ACTIVE=authmock

BELAYER_HOME=/opt/belayer
BELAYER_STORAGE_ROOT=/opt/belayer/storage
BELAYER_LOG_LEVEL=INFO
BELAYER_SERVER_PORT=8000

# Development only: open the management port (actuator, OpenAPI, Swagger UI; no authentication).
BELAYER_MANAGEMENT_ENABLED=true
BELAYER_MANAGEMENT_PORT=18000

TSURUGI_HOME=/usr/lib/tsurugi
TSURUGI_URL=ipc:tsurugi
